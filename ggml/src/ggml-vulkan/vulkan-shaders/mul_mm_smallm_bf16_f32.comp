#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable

// Small-M MUL_MAT for bf16 A: dst is [m, n] with m <= 8 while n and k are large.
// The generic mm shader pads the M tiles to 32+ and runs at a few percent of
// peak on this shape. Here one workgroup owns a 64-column block of dst and a
// slice of the k range (workgroup y = split index); B tiles are staged in
// shared memory with a coalesced load (consecutive invocations read
// consecutive k), so every B element is read from global memory exactly once.
// Partial planes are summed by mul_mat_split_k_reduce.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// A: bf16 bits, src0 [k, m]: element (kk, i) at kk + i*k (dim0 contiguous).
layout (binding = 0) readonly buffer A {uint16_t data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
// One partial plane per split, same element order as dst ([m, n] flattened).
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter {
    uint m;
    uint n;
    uint k;
    uint k_per_split;
} p;

const uint BN = 64;
const uint BK = 32;
const uint TM = 8;   // max m the kernel supports
const uint TN = 2;   // outputs per invocation (BN * TM == 2 * 256)

shared float bs[BN][BK + 1];  // pad: avoid the all-same-bank access pattern
shared float as[TM][BK];

float bf16_to_f32(uint16_t v) {
    // bf16 is the upper half of an f32 bit pattern; do NOT reinterpret as f16
    // (different exponent bias)
    return uintBitsToFloat(uint(v) << 16);
}

void main() {
    const uint t = gl_LocalInvocationID.x;
    const uint n0 = gl_WorkGroupID.x * BN;
    const uint split = gl_WorkGroupID.y;
    const uint k0 = split * p.k_per_split;
    const uint k1 = min(p.k, k0 + p.k_per_split);

    const uint o0 = t;
    const uint o1 = t + 256;
    // guard: only threads owning a real output may accumulate (j0/j1 can
    // otherwise index bs out of bounds)
    const bool v0 = o0 < p.m * BN;
    const uint i0 = v0 ? (o0 % p.m) : 0u;
    const uint j0 = v0 ? (o0 / p.m) : 0u;
    const bool v1 = o1 < p.m * BN;
    const uint i1 = v1 ? (o1 % p.m) : 0u;
    const uint j1 = v1 ? (o1 / p.m) : 0u;

    float acc0 = 0.0f;
    float acc1 = 0.0f;

    // Stream the split's k range in BK chunks; reuse the two shared tiles.
    for (uint kt = k0; kt < k1; kt += BK) {
        const uint kend = min(k1, kt + BK);
        for (uint idx = t; idx < BK * BN; idx += 256) {
            const uint kk = idx % BK;
            const uint j = idx / BK;
            const uint kn = kt + kk;
            const uint gn = n0 + j;
            bs[j][kk] = (kn < kend && gn < p.n) ? data_b[kn + gn * p.k] : 0.0f;
        }
        if (t < BK * TM) {
            const uint kk = t % BK;
            const uint i = t / BK;
            as[i][kk] = (i < p.m && kt + kk < kend) ? bf16_to_f32(data_a[(kt + kk) + i * p.k]) : 0.0f;
        }
        barrier();

        [[unroll]] for (uint kk = 0; kk < BK; ++kk) {
            acc0 += v0 ? as[i0][kk] * bs[j0][kk] : 0.0f;
            acc1 += v1 ? as[i1][kk] * bs[j1][kk] : 0.0f;
        }
        barrier();
    }

    const uint plane = split * p.m * p.n;
    if (v0 && n0 + j0 < p.n) {
        data_d[plane + i0 + (n0 + j0) * p.m] = acc0;
    }
    if (v1 && n0 + j1 < p.n) {
        data_d[plane + i1 + (n0 + j1) * p.m] = acc1;
    }
}
